# =============================================================================
# Reasoning Kits Environment Configuration
# =============================================================================
#
# Copy to .env and add your API keys:
#   cp .env.example .env
#
# At minimum, set OPENAI_API_KEY (or another provider key below).
# See SPEC.md for the full list of supported providers.

# =============================================================================
# LLM PROVIDERS (set at least one)
# =============================================================================

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Mistral — https://console.mistral.ai/
MISTRAL_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Default model for the main workflow (LiteLLM format)
# Examples: gpt-5.4-nano, claude-3-5-sonnet-latest, gemini/gemini-1.5-pro
RK_DEFAULT_MODEL=gpt-5.4-nano

# Log level: debug, info, warning, error
LOG_LEVEL=info

# Skip MCP initialization by default for `rk run` (override per-run with --no-mcp off)
# RK_NO_MCP=false